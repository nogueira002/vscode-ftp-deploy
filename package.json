{
  "name": "ftp-deploy-connector",
  "displayName": "FTP Deploy Connector",
  "description": "Connect to servers over SFTP/FTP, browse remote files in a tree, and download/upload — PhpStorm style.",
  "version": "0.2.3",
  "publisher": "nogueira002",
  "license": "MIT",
  "author": {
    "name": "Ricardo Nogueira"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nogueira002/vscode-ftp-deploy.git"
  },
  "bugs": {
    "url": "https://github.com/nogueira002/vscode-ftp-deploy/issues"
  },
  "homepage": "https://github.com/nogueira002/vscode-ftp-deploy#readme",
  "keywords": [
    "ftp",
    "sftp",
    "deploy",
    "deployment",
    "remote",
    "upload",
    "download",
    "sync"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ftpDeploy",
          "title": "FTP Deploy",
          "icon": "media/server.svg"
        }
      ]
    },
    "views": {
      "ftpDeploy": [
        {
          "id": "ftpDeployServers",
          "name": "Servers",
          "icon": "media/server.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ftpDeployServers",
        "contents": "No servers configured yet.\n[Add server](command:ftpDeploy.addConnection)"
      }
    ],
    "commands": [
      {
        "command": "ftpDeploy.addConnection",
        "title": "FTP Deploy: Add server",
        "icon": "$(add)"
      },
      {
        "command": "ftpDeploy.editConnection",
        "title": "FTP Deploy: Edit server",
        "icon": "$(edit)"
      },
      {
        "command": "ftpDeploy.deleteConnection",
        "title": "FTP Deploy: Remove server",
        "icon": "$(trash)"
      },
      {
        "command": "ftpDeploy.testConnection",
        "title": "FTP Deploy: Test connection",
        "icon": "$(plug)"
      },
      {
        "command": "ftpDeploy.refresh",
        "title": "FTP Deploy: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "ftpDeploy.download",
        "title": "FTP Deploy: Download (remote -> local)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ftpDeploy.uploadFile",
        "title": "FTP Deploy: Upload active file (local -> remote)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ftpDeploy.openRemoteFile",
        "title": "FTP Deploy: Open remote file"
      },
      {
        "command": "ftpDeploy.openSettings",
        "title": "FTP Deploy: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "ftpDeploy.uploadToServer",
        "title": "FTP Deploy: Upload to server",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ftpDeploy.addConnection",
          "when": "view == ftpDeployServers",
          "group": "navigation@1"
        },
        {
          "command": "ftpDeploy.refresh",
          "when": "view == ftpDeployServers",
          "group": "navigation@2"
        },
        {
          "command": "ftpDeploy.openSettings",
          "when": "view == ftpDeployServers",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "ftpDeploy.uploadToServer",
          "when": "resourceScheme == file",
          "group": "ftpDeploy@1"
        }
      ],
      "editor/context": [
        {
          "command": "ftpDeploy.uploadToServer",
          "when": "resourceScheme == file",
          "group": "ftpDeploy@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ftpDeploy.testConnection",
          "when": "view == ftpDeployServers && viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "ftpDeploy.editConnection",
          "when": "view == ftpDeployServers && viewItem == connection",
          "group": "1_manage@1"
        },
        {
          "command": "ftpDeploy.deleteConnection",
          "when": "view == ftpDeployServers && viewItem == connection",
          "group": "1_manage@2"
        },
        {
          "command": "ftpDeploy.download",
          "when": "view == ftpDeployServers && (viewItem == remoteFile || viewItem == remoteDir || viewItem == connection)",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ssh2-sftp-client": "^9.0.4",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
